[Unit]
Description=Battery run summary web app (gunicorn)
After=network.target

[Service]
Type=simple
User=battery-summary
Group=battery-summary
WorkingDirectory=/opt/solar-battery-tester-code/server

# Uploaded runs are kept here: runs/<battery id>/<run name>.{zip,json,png}.
# StateDirectory creates it, owned by the service user, before the app starts.
StateDirectory=battery-summary
Environment=BATTERY_RUNS_DIR=/var/lib/battery-summary/runs

ExecStart=/opt/solar-battery-tester-code/server/.venv/bin/gunicorn \
    -w 3 \
    -b 127.0.0.1:8000 \
    --timeout 120 \
    webapp:app
Restart=on-failure
RestartSec=5

# Hardening: this process only needs its own code/venv, its runs directory (which
# StateDirectory already makes writable) and 127.0.0.1:8000 -- it has no business
# touching the rest of the filesystem.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
